# Daily Dairy Production Configuration (Render / Turso Cloud / Local)
PORT=3000
NODE_ENV=production

# Initial Bootstrap Credentials
# Mandated to change on first login via the app UI
BOOTSTRAP_USERNAME=diary
BOOTSTRAP_PASSWORD=YourCustomInitialPasswordHere123!

# Turso Cloud SQLite Database (Recommended for Free Tier Persistence on Render)
# Create a free database at https://turso.tech (No credit card required)
# If provided, the server stores all entries and users in your persistent Turso cloud DB.
# If omitted, the server falls back to local SQLite file storage.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local Storage Directory & Fallback SQLite File
DATA_DIR=./data
DB_FILE=./data/daily_dairy.sqlite

# Web Push Notifications (Optional VAPID Keys)
# If left empty, the server automatically generates and persists them to vapid_keys.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@dailydairy.app
