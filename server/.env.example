# Daily Dairy Server Configuration
PORT=3000
NODE_ENV=production

# Initial Bootstrap Credentials
# Must be changed on first login via the app UI
BOOTSTRAP_USERNAME=diary
BOOTSTRAP_PASSWORD=ChangeThisOnFirstLogin!

# Storage file path
DATA_FILE=./data/diary_store.json

# Session secret for signing auth tokens
SESSION_SECRET=daily_dairy_secure_random_key_change_in_production_87391
